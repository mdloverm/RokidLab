<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BODY_SENSORS" />
    <uses-permission android:name="android.permission.HIGH_SAMPLING_RATE_SENSORS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <queries>
        <package android:name="mark.via.gp" />
        <package android:name="com.rokid.minigame" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:label="RokidLink"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RokidLink.Transparent">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".PhoneMirrorActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize"
            android:theme="@style/Theme.RokidLink.Opaque" />

        <activity
            android:name=".ScreenMirrorIntentActivity"
            android:exported="true"
            android:theme="@style/Theme.RokidLink.Transparent" />

        <!-- AIUI Web 宿主（官方 @yodaos-pkg/ink browser-integration + wasm）：
             渲染 Lab 生成的 .aix，眼镜按键 / Lab 蓝牙手柄(HID→KeyEvent) 注入为 ink 输入。
             exported=false：唯一启动方是同进程的 KeyButtonService（AiuiLinkActivity.open），
             不对外暴露 —— 否则任何第三方可带任意 aix_path 拉起本宿主，
             借页面 JS 桥直调手机端工具（工具数量见 ToolGateway）。 -->
        <activity
            android:name=".AiuiLinkActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|keyboardHidden"
            android:theme="@style/Theme.RokidLink.Opaque" />

        <!-- KeyButtonService 必须保持 exported=true：手机端经 ADB 隧道用
             `am start-foreground-service -n com.rokidlab.rokidlink/.KeyButtonService`
             拉起常驻服务（见 phone-app ai/ToolRegistry.ensureGlassesLinkRunning）。
             实测（眼镜 RG_glasses，非 root shell）：非导出的服务 / 非导出 Activity
             一律被拒（"Requires permission not exported from uid <app uid>"），
             而签名级自定义权限同样会把 shell 挡在门外 —— 二者都会静默打断
             「服务不在跑 → 所有 CXR 自定义指令石沉大海」这条关键路径，
             故此项保留导出，安全性由 ROM 层安装来源与用户授权承担。 -->
        <service
            android:name=".KeyButtonService"
            android:exported="true"
            android:foregroundServiceType="connectedDevice" />

        <service
            android:name=".BtTunnelService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!-- 断线自愈重启接收器：KeyButtonService 检测到 cxr-service 分发路由 stale 后
             经 AlarmManager 触发自杀重启（仅本应用内部广播，故 exported=false） -->
        <receiver
            android:name=".SelfRestartReceiver"
            android:exported="false" />

    </application>

</manifest>
