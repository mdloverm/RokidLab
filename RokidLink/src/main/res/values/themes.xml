<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 🚫 已废弃（2026-10-04）：透明窗口在 Rokid 绿光波导上等于「漏底色」。
         物理约束：绿光波导只发绿光，"黑"= 不发光 = 看起来透明；而 `color/transparent`
         是真的透明 ⇒ 会把下层 Launcher 的品牌绿 `#99BA00` 透出来，显示为淡绿底。
         ⚠️ 原判断"隐形入口页就该透明"是反的：这两个页面恰恰**不希望**透出任何东西
         （它们是常驻前台窗口，自启时压在 Launcher 上），透明只有害无益。
         下面保留仅为兼容旧引用，请勿在新页面使用；需要"看起来透明"一律用**不透明纯黑**。 -->
    <style name="Theme.RokidLink.Transparent" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- 不透明全屏主题：投屏 / AIUI / 常驻入口页一律用它。
         绿光波导上"不透明纯黑"才是正确的"看起来透明"（黑=不发光）。
         任何 `windowIsTranslucent=true` / `windowBackground=@android:color/transparent`
         都会漏出下层绿色 ⇒ 页面底色发绿。 -->
    <style name="Theme.RokidLink.Opaque" parent="@android:style/Theme.NoTitleBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
